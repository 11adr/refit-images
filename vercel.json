{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "worker.js",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "wasm_exec.js",
      "use": "@vercel/static"
    },
    {
      "src": "caire.wasm",
      "use": "@vercel/static"
    },
    {
      "src": "sample.jpg",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/caire.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    }
  ]
}
